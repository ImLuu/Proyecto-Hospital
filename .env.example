# Copia este archivo como .env y cambia los valores:
#   cp .env.example .env

# Entorno: dev | test | prod
APP_ENV=dev

# Puerto de tu PC donde verás la web: http://localhost:8080
APP_PORT=8080

# Conexión a PostgreSQL.
# DB_HOST=db es el nombre del servicio en docker-compose (DNS interno de Docker).
DB_HOST=db
DB_PORT=5432
DB_NAME=hospital
DB_USER=hospital_user
DB_PASSWORD=cambia_esta_clave

# Puerto de tu PC para conectarte a la BD con DBeaver/pgAdmin (solo Dev)
DB_EXTERNAL_PORT=5432
